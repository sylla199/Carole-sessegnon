{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/forms/**",
              "ui_kits/boutique/**",
              "ui_kits/boutique/Screens/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bodoni Moda|Celias))/i]",
        "message": "Font not provided by the design system. Available: Bodoni Moda, Celias."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|question|answer|open|onToggle|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: className, style, question, answer, open, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|variant|size|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: className, style, variant, size, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|light)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardProduit'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|text1|text2|text3|key|ref|className|style|children)$/]",
        "message": "<CardProduit> doesn't accept that prop. Declared props: className, style, property1, text1, text2, text3."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardProduit'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default card|hover|variant3)$/]",
        "message": "<CardProduit> property1 must be one of 'default card' | 'hover' | 'variant3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Categoris'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|key|ref|className|style|children)$/]",
        "message": "<Categoris> doesn't accept that prop. Declared props: className, style, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|checked|children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: className, style, checked, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContinueWithAppleLeftAligned'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|key|ref|className|style|children)$/]",
        "message": "<ContinueWithAppleLeftAligned> doesn't accept that prop. Declared props: className, style, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContinueWithGoogleLeftAligned'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|key|ref|className|style|children)$/]",
        "message": "<ContinueWithGoogleLeftAligned> doesn't accept that prop. Declared props: className, style, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|text4|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: className, style, text1, text2, text3, text4."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|label|placeholder|defaultValue|type|disabled|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: className, style, label, placeholder, defaultValue, type, disabled, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: className, style, property1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:cs-logo-combi 1|cs-logomark 1|cs-logotype 1|c 1|cs_ 1|s 1)$/]",
        "message": "<Logo> property1 must be one of 'cs-logo-combi 1' | 'cs-logomark 1' | 'cs-logotype 1' | 'c 1' | 'cs_ 1' | 's 1'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|text1|key|ref|className|style|children)$/]",
        "message": "<Menu> doesn't accept that prop. Declared props: className, style, property1, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|hover|focus)$/]",
        "message": "<Menu> property1 must be one of 'default' | 'hover' | 'focus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|text1|key|ref|className|style|children)$/]",
        "message": "<Navbar> doesn't accept that prop. Declared props: className, style, property1, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navbar'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:navbar default|navbar clair|connecte black|connecte)$/]",
        "message": "<Navbar> property1 must be one of 'navbar default' | 'navbar clair' | 'connecte black' | 'connecte'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecapCommande'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|text4|key|ref|className|style|children)$/]",
        "message": "<RecapCommande> doesn't accept that prop. Declared props: className, style, text1, text2, text3, text4."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
